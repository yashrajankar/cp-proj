{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "aicn",
  "version": "1.0.0",
  "description": "AICN - AI Classroom Notifier",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/init-db.js",
    "create-classroom-tables": "node scripts/create-classroom-tables.js",
    "convert-seating-to-classroom": "node scripts/convert-seating-to-classroom.js",
    "populate-assigned-classrooms": "node scripts/populate-assigned-classrooms.js",
    "run-migration": "node scripts/run-migration.js",
    "reset-db": "node scripts/reset-db.js",
    "monitor-db": "node scripts/monitor-database.js",
    "test-db": "jest --testPathPattern=scripts/test-db.js",
    "test": "jest",
    "create-admin": "node scripts/create-admin-user.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csurf": "^1.11.0",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.1.0",
    "express-session": "^1.17.3",
    "express-validator": "^7.2.1",
    "mysql2": "^3.9.7",
    "node-fetch": "^3.3.2",
    "pdfmake": "^0.2.20",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  }
}
